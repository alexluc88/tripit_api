# Copy to .env and fill in. Only email/password Auth0 logins can be automated;
# Google "Sign in with" cannot. .env is gitignored.
EF_EMAIL=you@example.com
EF_PASSWORD=your-password

# Optional knobs (defaults shown):
# EF_HEADLESS=true            # set false to watch the browser / clear MFA manually
# EF_INSECURE_TLS=false       # set true ONLY behind a TLS-intercepting proxy
# EF_STATE_FILE=.efstate.json # where the logged-in session cookies are cached
# EF_OUT_DIR=out              # where screenshots / json land
# EF_TIMEOUT_MS=45000
