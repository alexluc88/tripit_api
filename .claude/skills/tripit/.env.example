# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Register an app at https://www.tripit.com/developer to get these:
TRIPIT_API_KEY=your-api-key
TRIPIT_API_SECRET=your-api-secret

# Filled in after `tripit login` + `tripit login --complete`. Export these to
# persist authorization across ephemeral cloud sessions (otherwise they live in
# the gitignored state file):
# TRIPIT_TOKEN=...
# TRIPIT_TOKEN_SECRET=...

# Optional knobs (defaults shown):
# TRIPIT_INSECURE_TLS=false        # set true ONLY behind a TLS-intercepting proxy
# TRIPIT_STATE_FILE=.tripit_state.json
# TRIPIT_TIMEOUT=45
# TRIPIT_API_URL=https://api.tripit.com
# TRIPIT_WEB_URL=https://www.tripit.com
