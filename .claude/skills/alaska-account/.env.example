# Copy to .env and fill in. Use your own alaskaair.com credentials only.
# .env is gitignored.
AS_USERNAME=you@example.com
AS_PASSWORD=your-password

# Optional knobs (defaults shown):
# AS_HEADLESS=true            # set false to watch the browser / clear the bot
#                             # challenge + type the emailed 2FA code manually
# AS_BROWSER_CHANNEL=         # set "chrome" on a real machine for best stealth
# AS_INSECURE_TLS=false       # set true ONLY behind a TLS-intercepting proxy
# AS_PROFILE_DIR=.as-profile  # persistent browser profile (cached session lives here)
# AS_2FA_FILE=/tmp/as-2fa-code.txt   # where to drop the emailed one-time code
# AS_2FA_WAIT_MS=180000       # how long to wait for the 2FA code / challenge
# AS_OUT_DIR=out              # where dump-dom artifacts land
# AS_TIMEOUT_MS=60000
# Override portal routes if Alaska moves them (Mileage Plan -> Atmos Rewards):
# AS_LOGIN_PATH=/account/login
# AS_OVERVIEW_PATH=/account/overview
# AS_WALLET_PATH=/account/wallet
# AS_ACTIVITY_PATH=/account/activity
